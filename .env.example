# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Target Telegram group/channel ID (negative number for groups, e.g. -1001234567890)
NEWS_CHANNEL_ID=-1001234567890

# Topic (message thread) ID within the group (0 = no topic / general chat)
NEWS_TOPIC_ID=0

# How often to check for new articles, in seconds (default: 3600 = 1 hour)
CHECK_INTERVAL=3600

# Maximum number of articles to post per check cycle
MAX_ARTICLES_PER_CHECK=3

# OpenAI model to use for article processing
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of Telegram user IDs that are allowed to use admin commands
ADMIN_IDS=123456789
