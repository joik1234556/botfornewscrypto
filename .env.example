# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── AI Provider ──────────────────────────────────────────────────────────────
# The bot works with ANY OpenAI-compatible API.
# Set AI_API_KEY to your provider's API key and AI_BASE_URL to the endpoint.
# OPENAI_API_KEY is also accepted as a fallback if AI_API_KEY is not set.

# --- Option 1: OpenAI (default, no AI_BASE_URL needed) ---
AI_API_KEY=your_openai_api_key_here
# AI_BASE_URL=               # leave empty for OpenAI
# AI_MODEL=gpt-4o-mini

# --- Option 2: Groq (very fast, free tier available) ---
# AI_API_KEY=your_groq_api_key_here
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# --- Option 3: Mistral ---
# AI_API_KEY=your_mistral_api_key_here
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-small-latest

# --- Option 4: Together AI ---
# AI_API_KEY=your_together_api_key_here
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3-8b-chat-hf

# --- Option 5: DeepSeek ---
# AI_API_KEY=your_deepseek_api_key_here
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# --- Option 6: OpenRouter (routes to 100+ models, incl. Claude & Gemini) ---
# AI_API_KEY=your_openrouter_api_key_here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-3.5-sonnet

# ─────────────────────────────────────────────────────────────────────────────

# Target Telegram group/channel ID (negative number for groups, e.g. -1001234567890)
NEWS_CHANNEL_ID=-1001234567890

# Topic (message thread) ID within the group (0 = no topic / general chat)
NEWS_TOPIC_ID=0

# How often to check for new articles, in seconds (default: 3600 = 1 hour)
CHECK_INTERVAL=3600

# Maximum number of articles to post per check cycle
MAX_ARTICLES_PER_CHECK=3

# Comma-separated list of Telegram user IDs that are allowed to use admin commands
ADMIN_IDS=123456789
